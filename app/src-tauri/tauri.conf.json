{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mèche",
  "mainBinaryName": "meche",
  "version": "0.1.0",
  "identifier": "fr.pierrebultez.meche",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mèche",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Notes personnelles rapides et colorées",
    "longDescription": "Mèche : des notes personnelles rapides et colorées. Allumez la mèche d'une note jetable : elle explose toute seule à la fin du compte à rebours.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
