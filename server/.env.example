# Mèche sync API. Copy to .env on the server and fill in the values (never commit .env:
# the repository is public). `php artisan key:generate` fills APP_KEY.
APP_NAME=Meche
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://meche.pierrebultez.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meche
DB_USERNAME=meche
DB_PASSWORD=

# API only: no sessions, no queue. The cache (rate limits, scheduler locks) is a local file.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=log
